#轨迹模型数据格式
library(dplyr)
library(lubridate)
library(tidyr)

# 1. 取出目标 stay 列表
target_stays <- unique(df_teacher_new$stay_id)
safe_sql <- function(x) paste(unique(x), collapse = ",")

# 2. 拉取所有 ICU 期间的 GCS，并按小时聚合（同小时取 min）
gcs_all <- bq_table_download(
  bq_project_query(projectid, sprintf("
    SELECT 
      g.stay_id,
      g.charttime,
      g.gcs
    FROM `physionet-data.mimiciv_3_1_derived.gcs` g
    JOIN `physionet-data.mimiciv_3_1_icu.icustays` icu 
      ON g.stay_id = icu.stay_id
    WHERE g.stay_id IN (%s)
      AND g.charttime >= icu.intime 
      AND g.charttime <= icu.outtime
      AND g.gcs IS NOT NULL
  ", safe_sql(target_stays))),
  page_size = 1e5
)

# 对齐到整点，并取同一小时的最小GCS
gcs_hourly <- gcs_all %>%
  mutate(charttime_h = floor_date(charttime, "hour")) %>%
  group_by(stay_id, charttime_h) %>%
  summarise(gcs_min = min(gcs), .groups = "drop")

# 3. 为每个 stay 生成 intime→outtime 的每小时时间轴
icustays <- bq_table_download(
  bq_project_query(projectid, sprintf("
    SELECT stay_id, intime, outtime
    FROM `physionet-data.mimiciv_3_1_icu.icustays`
    WHERE stay_id IN (%s)
  ", safe_sql(target_stays))),
  page_size = 1e5
)

# 生成每小时1行
icu_time_grid <- icustays %>%
  mutate(
    hour_seq = purrr::map2(intime, outtime, ~ seq(floor_date(.x, "hour"), floor_date(.y, "hour"), by = "hour"))
  ) %>%
  unnest(hour_seq) %>%
  rename(charttime_h = hour_seq)

# 4. 把 GCS 和时间轴合并（没数据的小时为 NA）
icu_gcs <- icu_time_grid %>%
  left_join(gcs_hourly, by = c("stay_id", "charttime_h"))

# 5. 合并回你的主表，带上所有基线变量
df_trajectory <- df_teacher_new %>%
  select(subject_id, stay_id, age, everything()) %>%
  left_join(icu_gcs, by = "stay_id") %>%
  
  # ✅ 关键排序：和你截图格式完全一致
  arrange(
    subject_id,    # 1. 先按患者分组，同一个人排在一起
    age,           # 2. 同一个患者内部，按年龄从小到大
    charttime_h    # 3. 同年龄按时间排序
  ) %>%
  
  # 调整列顺序，让关键变量在前面
  select(
    subject_id, stay_id, age, charttime_h, gcs_min,
    everything()
  )

# 6. 导出最终文件
write.csv(df_trajectory, "~/Desktop/df_trajectory_final_hourly.csv", row.names = FALSE, na = "")
