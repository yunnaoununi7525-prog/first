make_numeric_matrix <- function(data, features) {
  out <- data %>%
    select(all_of(features)) %>%
    mutate(across(everything(), ~ as_num(.)))
  as.matrix(out)
}

impute_by_train_median <- function(x_train, x_test) {
  med <- apply(x_train, 2, function(x) {
    m <- median(x, na.rm = TRUE)
    ifelse(is.na(m), 0, m)
  })

  for (j in seq_along(med)) {
    x_train[is.na(x_train[, j]), j] <- med[j]
    x_test[is.na(x_test[, j]), j] <- med[j]
  }

  list(train = x_train, test = x_test, medians = med)
}

impute_matrix_all <- function(x) {
  med <- apply(x, 2, function(v) {
    m <- median(v, na.rm = TRUE)
    ifelse(is.na(m), 0, m)
  })

  for (j in seq_along(med)) {
    x[is.na(x[, j]), j] <- med[j]
  }

  x
}

make_stratified_split <- function(y, train_prop = 0.8) {
  y <- as.factor(y)
  idx <- seq_along(y)
  train_idx <- unlist(lapply(split(idx, y), function(i) {
    sample(i, size = max(1, floor(length(i) * train_prop)))
  }), use.names = FALSE)
  sort(unique(train_idx))
}

calc_auc <- function(actual, score) {
  actual <- as_num(actual)
  score <- as_num(score)
  ok <- !is.na(actual) & !is.na(score)
  actual <- actual[ok]
  score <- score[ok]

  if (length(unique(actual)) < 2) return(NA_real_)

  n_pos <- sum(actual == 1)
  n_neg <- sum(actual == 0)
  if (n_pos == 0 || n_neg == 0) return(NA_real_)

  ranks <- rank(score, ties.method = "average")
  (sum(ranks[actual == 1]) - n_pos * (n_pos + 1) / 2) / (n_pos * n_neg)
}

roc_curve <- function(actual, score) {
  actual <- as.integer(actual)
  score <- as_num(score)
  ok <- !is.na(actual) & !is.na(score)
  actual <- actual[ok]
  score <- score[ok]

  ord <- order(score, decreasing = TRUE)
  actual <- actual[ord]
  score <- score[ord]

  pos <- sum(actual == 1)
  neg <- sum(actual == 0)
  if (pos == 0 || neg == 0) {
    return(data.frame(fpr = c(0, 1), tpr = c(0, 1)))
  }

  tp <- cumsum(actual == 1)
  fp <- cumsum(actual == 0)

  data.frame(
    fpr = c(0, fp / neg, 1),
    tpr = c(0, tp / pos, 1)
  ) %>%
    distinct(fpr, .keep_all = TRUE) %>%
    arrange(fpr)
}

make_binary_roc_plot <- function(actual, prob_df, title) {
  roc_rows <- list()
  auc_rows <- list()

  for (model_name in names(prob_df)) {
    p <- prob_df[[model_name]]
    auc_value <- calc_auc(actual, p)
    curve <- roc_curve(actual, p) %>%
      mutate(
        model = paste0(model_name, " (AUC=", sprintf("%.3f", auc_value), ")"),
        model_raw = model_name,
        auc = auc_value
      )
    roc_rows[[model_name]] <- curve
    auc_rows[[model_name]] <- data.frame(model = model_name, auc = auc_value)
  }

  roc_df <- bind_rows(roc_rows)
  auc_df <- bind_rows(auc_rows)

  plot <- ggplot(roc_df, aes(x = fpr, y = tpr, color = model)) +
    geom_line(linewidth = 1.05) +
    geom_abline(slope = 1, intercept = 0, linetype = 2, color = "grey60") +
    coord_equal() +
    labs(title = title, x = "1 - Specificity", y = "Sensitivity", color = NULL) +
    theme_classic(base_family = "Times") +
    theme(
      plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
      legend.position = "bottom"
    )

  list(plot = plot, auc = auc_df, roc = roc_df)
}

make_macro_roc_plot <- function(actual_class, prob_list, title) {
  actual_class <- factor(actual_class)
  classes <- levels(actual_class)
  grid_fpr <- seq(0, 1, length.out = 101)

  macro_rows <- list()
  auc_rows <- list()

  for (model_name in names(prob_list)) {
    prob_mat <- prob_list[[model_name]]
    class_aucs <- c()
    tpr_grid <- matrix(NA_real_, nrow = length(grid_fpr), ncol = length(classes))

    for (j in seq_along(classes)) {
      cls <- classes[j]
      actual_binary <- as.integer(actual_class == cls)
      score <- prob_mat[, cls]
      curve <- roc_curve(actual_binary, score)
      class_aucs[j] <- calc_auc(actual_binary, score)
      tpr_grid[, j] <- approx(
        x = curve$fpr,
        y = curve$tpr,
        xout = grid_fpr,
        ties = "ordered",
        rule = 2
      )$y
    }

    macro_auc <- mean(class_aucs, na.rm = TRUE)
    macro_rows[[model_name]] <- data.frame(
      fpr = grid_fpr,
      tpr = rowMeans(tpr_grid, na.rm = TRUE),
      model = paste0(model_name, " (macro AUC=", sprintf("%.3f", macro_auc), ")"),
      model_raw = model_name,
      auc = macro_auc
    )
    auc_rows[[model_name]] <- data.frame(model = model_name, auc = macro_auc)
  }

  roc_df <- bind_rows(macro_rows)
  auc_df <- bind_rows(auc_rows)

  plot <- ggplot(roc_df, aes(x = fpr, y = tpr, color = model)) +
    geom_line(linewidth = 1.05) +
    geom_abline(slope = 1, intercept = 0, linetype = 2, color = "grey60") +
    coord_equal() +
    labs(title = title, x = "1 - Specificity", y = "Sensitivity", color = NULL) +
    theme_classic(base_family = "Times") +
    theme(
      plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
      legend.position = "bottom"
    )

  list(plot = plot, auc = auc_df, roc = roc_df)
}

