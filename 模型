risk_features <- c(
  "first_day_SOFA",
  "first_day_invasive_vent",
  "first_day_noninvasive_vent",
  "first_day_hfnc",
  "first_day_tracheostomy"
)
risk_features <- risk_features[risk_features %in% names(df)]

fit_risk_model <- function(cluster_col, label) {
  model_data <- df %>%
    select(hospital_death_flag, all_of(cluster_col), all_of(risk_features)) %>%
    rename(cluster = all_of(cluster_col)) %>%
    mutate(cluster = factor(cluster)) %>%
    mutate(across(all_of(risk_features), ~ as_num(.))) %>%
    drop_na(hospital_death_flag, cluster) %>%
    mutate(cluster = droplevels(cluster))

  if (nlevels(model_data$cluster) < 2) {
    stop(label, " has fewer than 2 GCS trajectory classes after excluding missing labels.")
  }

  for (v in risk_features) {
    med <- median(model_data[[v]], na.rm = TRUE)
    if (is.na(med)) med <- 0
    model_data[[v]][is.na(model_data[[v]])] <- med
  }

  fit <- suppressWarnings(glm(
    hospital_death_flag ~ cluster + first_day_SOFA +
      first_day_invasive_vent + first_day_noninvasive_vent +
      first_day_hfnc + first_day_tracheostomy,
    data = model_data,
    family = binomial()
  ))

  coef_df <- as.data.frame(summary(fit)$coefficients)
  coef_df$term <- rownames(coef_df)
  rownames(coef_df) <- NULL
  names(coef_df)[1:4] <- c("estimate", "std_error", "z", "p_value")

  coef_df %>%
    filter(term != "(Intercept)") %>%
    mutate(
      model = label,
      OR = exp(estimate),
      CI_low = exp(estimate - 1.96 * std_error),
      CI_high = exp(estimate + 1.96 * std_error),
      term_label = case_when(
        grepl("^cluster", term) ~ paste0(gsub("^cluster", "", term), " vs Cluster 1"),
        term == "first_day_SOFA" ~ "First-day SOFA",
        term == "first_day_invasive_vent" ~ "First-day invasive ventilation",
        term == "first_day_noninvasive_vent" ~ "First-day noninvasive ventilation",
        term == "first_day_hfnc" ~ "First-day HFNC",
        term == "first_day_tracheostomy" ~ "First-day tracheostomy",
        TRUE ~ pretty_feature(term)
      )
    )
}

risk_results <- bind_rows(
  fit_risk_model("cluster_k2", "k=2 cluster model"),
  fit_risk_model("cluster_k3", "k=3 cluster model"),
  fit_risk_model("cluster_k4", "k=4 cluster model")
)

write.csv(
