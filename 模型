  }
}

make_cluster_summary <- function(cluster_col, label) {
  labelled_n <- sum(!is.na(df[[cluster_col]]))
  missing_cluster_n <- sum(is.na(df[[cluster_col]]))

  df %>%
    filter(!is.na(.data[[cluster_col]])) %>%
    group_by(cluster = .data[[cluster_col]]) %>%
    summarise(
      n = n(),
      death_rate = mean(hospital_death_flag == 1, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      cluster_model = label,
      labelled_n = labelled_n,
      missing_cluster_n = missing_cluster_n,
      cluster_source = cluster_source
    ) %>%
    select(cluster_model, cluster, n, death_rate, labelled_n, missing_cluster_n, cluster_source)
}

