scale_feature_value <- function(x) {
  x <- as_num(x)
  if (all(is.na(x))) return(rep(NA_real_, length(x)))
  q25 <- quantile(x, 0.25, na.rm = TRUE, names = FALSE)
  q75 <- quantile(x, 0.75, na.rm = TRUE, names = FALSE)
  iqr_x <- q75 - q25
  if (is.na(iqr_x) || iqr_x == 0) {
    z <- x - median(x, na.rm = TRUE)
  } else {
    z <- (x - median(x, na.rm = TRUE)) / iqr_x
  }
  pmax(pmin(z, 2), -2)
}

make_shap_plot <- function(xgb_model, x_test, title, top_n = 10) {
  shap_values <- predict(xgb_model, xgb.DMatrix(x_test), predcontrib = TRUE)

  expected_names <- c(colnames(x_test), "BIAS")
  if (
    is.null(colnames(shap_values)) ||
      length(colnames(shap_values)) != length(expected_names) ||
      !all(colnames(shap_values) %in% expected_names)
  ) {
    colnames(shap_values) <- expected_names[seq_len(ncol(shap_values))]
  }

  shap_values <- shap_values[, colnames(shap_values) != "BIAS", drop = FALSE]

  common_features <- intersect(colnames(shap_values), colnames(x_test))
  shap_values <- shap_values[, common_features, drop = FALSE]

  shap_importance <- data.frame(
    feature = colnames(shap_values),
    mean_abs_shap = colMeans(abs(shap_values), na.rm = TRUE),
    row.names = NULL
  ) %>%
    arrange(desc(mean_abs_shap))

  top_features <- shap_importance$feature[seq_len(min(top_n, nrow(shap_importance)))]

  shap_long <- as.data.frame(shap_values[, top_features, drop = FALSE]) %>%
    mutate(row_id = row_number()) %>%
    pivot_longer(cols = all_of(top_features), names_to = "feature", values_to = "shap_value")

  value_long <- as.data.frame(x_test[, top_features, drop = FALSE]) %>%
    mutate(row_id = row_number()) %>%
    pivot_longer(cols = all_of(top_features), names_to = "feature", values_to = "feature_value")

  feature_order <- rev(top_features)
  feature_labels <- pretty_feature(feature_order)
  names(feature_labels) <- feature_order

  shap_long <- shap_long %>%
    left_join(value_long, by = c("row_id", "feature")) %>%
    group_by(feature) %>%
    mutate(feature_value_scaled = scale_feature_value(feature_value)) %>%
    ungroup() %>%
    mutate(
      feature = factor(feature, levels = feature_order),
      feature_label = factor(pretty_feature(as.character(feature)), levels = feature_labels)
    )

  plot <- ggplot(shap_long, aes(x = shap_value, y = feature_label, color = feature_value_scaled)) +
    geom_vline(xintercept = 0, color = "grey35", linewidth = 0.55) +
    geom_point(alpha = 0.68, size = 1.3, position = position_jitter(height = 0.18, width = 0)) +
    scale_color_gradient(low = "#7A7A7A", high = "#1F78B4", na.value = "#BDBDBD", name = "Feature value") +
    labs(title = title, x = "SHAP value impact", y = NULL) +
    theme_classic(base_family = "Times") +
    theme(
      plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
      axis.title.x = element_text(size = 12, face = "bold"),
      axis.text.y = element_text(size = 10.5),
      legend.position = "right"
    )

  list(plot = plot, importance = shap_importance)
}

fit_predict_binary_models <- function(data, outcome, features, title_prefix) {
  data <- data %>%
    filter(!is.na(.data[[outcome]]))

  y <- as.integer(data[[outcome]] == 1)
  if (length(unique(y)) < 2) {
    stop(title_prefix, " has fewer than 2 outcome classes after excluding missing labels.")
  }

  train_idx <- make_stratified_split(y)
  test_idx <- setdiff(seq_along(y), train_idx)

  x_all <- make_numeric_matrix(data, features)
  x_train <- x_all[train_idx, , drop = FALSE]
  x_test <- x_all[test_idx, , drop = FALSE]
  imp <- impute_by_train_median(x_train, x_test)
  x_train <- imp$train
  x_test <- imp$test
  y_train <- y[train_idx]
  y_test <- y[test_idx]

  train_df <- as.data.frame(x_train)
  train_df$.y <- y_train
  test_df <- as.data.frame(x_test)

  glm_fit <- suppressWarnings(glm(.y ~ ., data = train_df, family = binomial()))
  pred_glm <- suppressWarnings(as.numeric(predict(glm_fit, newdata = test_df, type = "response")))

  cv_glmnet <- suppressWarnings(cv.glmnet(
    x = x_train,
    y = y_train,
    family = "binomial",
    alpha = 1,
    nfolds = 5,
    type.measure = "auc",
    standardize = TRUE
  ))
  pred_glmnet <- as.numeric(predict(cv_glmnet, newx = x_test, s = "lambda.min", type = "response"))

  dtrain <- xgb.DMatrix(x_train, label = y_train)
  dtest <- xgb.DMatrix(x_test, label = y_test)
  xgb_fit <- xgb.train(
    params = list(
      objective = "binary:logistic",
      eval_metric = "auc",
      max_depth = 3,
      eta = 0.05,
      min_child_weight = 10,
      subsample = 0.85,
      colsample_bytree = 0.85,
      scale_pos_weight = sum(y_train == 0) / sum(y_train == 1)
    ),
    data = dtrain,
    nrounds = 250,
    verbose = 0
  )
  pred_xgb <- as.numeric(predict(xgb_fit, dtest))

  prob_df <- list(
    "Logistic regression" = pred_glm,
    "LASSO logistic" = pred_glmnet,
    "XGBoost" = pred_xgb
  )

  roc_result <- make_binary_roc_plot(
    actual = y_test,
    prob_df = prob_df,
    title = paste0(title_prefix, ": AUROC")
  )

  shap_result <- make_shap_plot(
    xgb_model = xgb_fit,
    x_test = x_test,
    title = paste0(title_prefix, ": XGBoost SHAP")
  )

  list(
    roc_plot = roc_result$plot,
    auc = roc_result$auc,
    shap_plot = shap_result$plot,
    shap_importance = shap_result$importance,
    xgb_model = xgb_fit,
    x_test = x_test,
    y_test = y_test
  )
}

fit_predict_multiclass_models <- function(data, outcome, features, title_prefix) {
  data <- data %>%
    filter(!is.na(.data[[outcome]]), trimws(as.character(.data[[outcome]])) != "")

  y <- droplevels(factor(data[[outcome]]))
  classes <- levels(y)
  if (length(classes) < 2) {
    stop(title_prefix, " has fewer than 2 outcome classes after excluding missing labels.")
  }

  train_idx <- make_stratified_split(y)
  test_idx <- setdiff(seq_along(y), train_idx)

  x_all <- make_numeric_matrix(data, features)
  x_train <- x_all[train_idx, , drop = FALSE]
  x_test <- x_all[test_idx, , drop = FALSE]
  imp <- impute_by_train_median(x_train, x_test)
  x_train <- imp$train
  x_test <- imp$test
  y_train <- factor(y[train_idx], levels = classes)
  y_test <- factor(y[test_idx], levels = classes)

  train_df <- as.data.frame(x_train)
  train_df$.y <- y_train
  test_df <- as.data.frame(x_test)

  multinom_fit <- suppressWarnings(nnet::multinom(.y ~ ., data = train_df, trace = FALSE, maxit = 300))
  pred_multinom <- predict(multinom_fit, newdata = test_df, type = "probs")
  if (is.null(dim(pred_multinom))) {
    pred_multinom <- cbind(`1` = 1 - pred_multinom, `2` = pred_multinom)
  }
  pred_multinom <- as.matrix(pred_multinom)
  colnames(pred_multinom) <- classes

  y_train_num <- as.integer(y_train) - 1
  y_test_num <- as.integer(y_test) - 1

  cv_glmnet <- suppressWarnings(cv.glmnet(
    x = x_train,
    y = y_train,
    family = "multinomial",
    alpha = 1,
    nfolds = 5,
    type.measure = "deviance",
    standardize = TRUE
  ))
  pred_glmnet_arr <- predict(cv_glmnet, newx = x_test, s = "lambda.min", type = "response")
  pred_glmnet <- pred_glmnet_arr[, , 1, drop = TRUE]
  pred_glmnet <- as.matrix(pred_glmnet)
  colnames(pred_glmnet) <- classes

  dtrain <- xgb.DMatrix(x_train, label = y_train_num)
  dtest <- xgb.DMatrix(x_test, label = y_test_num)
  xgb_fit <- xgb.train(
    params = list(
      objective = "multi:softprob",
      eval_metric = "mlogloss",
      num_class = length(classes),
      max_depth = 3,
      eta = 0.05,
      min_child_weight = 10,
      subsample = 0.85,
      colsample_bytree = 0.85
    ),
    data = dtrain,
    nrounds = 250,
    verbose = 0
  )
  pred_xgb_raw <- predict(xgb_fit, dtest)
  pred_xgb <- as.matrix(pred_xgb_raw)

  if (ncol(pred_xgb) != length(classes)) {
    pred_xgb_vec <- as.numeric(pred_xgb_raw)
    pred_xgb_byrow <- matrix(pred_xgb_vec, ncol = length(classes), byrow = TRUE)
    pred_xgb_bycol <- matrix(pred_xgb_vec, ncol = length(classes), byrow = FALSE)

    # Choose the orientation with the better macro AUC on the test set.
    colnames(pred_xgb_byrow) <- classes
    colnames(pred_xgb_bycol) <- classes
    auc_byrow <- make_macro_roc_plot(y_test, list(x = pred_xgb_byrow), "tmp")$auc$auc[1]
    auc_bycol <- make_macro_roc_plot(y_test, list(x = pred_xgb_bycol), "tmp")$auc$auc[1]
    pred_xgb <- if (is.na(auc_bycol) || (!is.na(auc_byrow) && auc_byrow >= auc_bycol)) {
      pred_xgb_byrow
    } else {
      pred_xgb_bycol
    }
  }
  colnames(pred_xgb) <- classes

  prob_list <- list(
    "Multinomial logistic" = pred_multinom,
    "LASSO multinomial" = pred_glmnet,
    "XGBoost" = pred_xgb
  )

  roc_result <- make_macro_roc_plot(
    actual_class = y_test,
    prob_list = prob_list,
    title = paste0(title_prefix, ": Macro-average AUROC")
  )

  list(
    roc_plot = roc_result$plot,
    auc = roc_result$auc,
    xgb_model = xgb_fit,
