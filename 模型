clean_cluster_label <- function(x, k) {
  x <- trimws(as.character(x))
  x[x == ""] <- NA_character_
  factor(x, levels = paste0("Class ", seq_len(k)))
}

read_trajectory_clusters <- function(path, cols) {
  trajectory_df <- read.csv(path, stringsAsFactors = FALSE, check.names = FALSE)
  required <- c("stay_id", cols)
  missing_cols <- setdiff(required, names(trajectory_df))
  if (length(missing_cols) > 0) {
    stop("Trajectory cluster table is missing required columns: ", paste(missing_cols, collapse = ", "))
  }

  trajectory_df %>%
    select(all_of(required)) %>%
    mutate(stay_id = as.character(stay_id)) %>%
    distinct(stay_id, .keep_all = TRUE)
}

trajectory_clusters <- read_trajectory_clusters(
  trajectory_k2_path,
  c("gcs_cluster_base_k2")
) %>%
  full_join(
    read_trajectory_clusters(
      trajectory_k3_k4_path,
      c("gcs_cluster_base_k3", "gcs_cluster_base_k4")
    ),
    by = "stay_id"
  ) %>%
  transmute(
    stay_id,
    cluster_k2 = clean_cluster_label(gcs_cluster_base_k2, 2),
    cluster_k3 = clean_cluster_label(gcs_cluster_base_k3, 3),
    cluster_k4 = clean_cluster_label(gcs_cluster_base_k4, 4)
  )

