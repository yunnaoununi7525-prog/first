##加在修改版2.3后 导出结果为df_teacher_new2.4_trajectory.csv

# 加载
library(dplyr)
library(lubridate)
library(data.table)

# --------------------------
# 1. 定义目标队列核心信息（从已有的df_teacher_new里取，不额外拉取）
# --------------------------
target_cohort = df_teacher_new %>%
  select(subject_id, hadm_id, stay_id, intime) %>%
  distinct() # 去重，确保每个stay_id唯一
target_stay_ids = unique(target_cohort$stay_id)

# --------------------------
# 2. 拉取目标队列全量GCS时序数据（全ICU周期，不止前24h）
# --------------------------
# 安全SQL拼接函数
safe_sql = function(x) paste(unique(x), collapse = ",")

# 拉取GCS全量数据
gcs_full_ts = bq_table_download(
  bq_project_query(
    projectid,
    sprintf("
      SELECT stay_id, charttime, gcs
      FROM `physionet-data.mimiciv_3_1_derived.gcs`
      WHERE stay_id IN (%s)
    ", safe_sql(target_stay_ids))
  ),
  page_size = 1e5
)

# --------------------------
# 3. 计算相对ICU入院的小时数（时间轴核心）
# --------------------------
gcs_with_hour = gcs_full_ts %>%
  # 匹配患者入院时间
  left_join(target_cohort, by = "stay_id") %>%
  # 时间格式统一
  mutate(
    intime = as.POSIXct(intime),
    charttime = as.POSIXct(charttime),
    # 核心：计算相对ICU入院的小时数，向下取整归到自然小时
    hour_offset = floor(as.numeric(difftime(charttime, intime, units = "hour")))
  ) %>%
  # 剔除入院前的无效数据（hour_offset<0）
  filter(hour_offset >= 0)

# --------------------------
# 4. 同小时GCS取最小值
# --------------------------
# 用data.table高速聚合，解决百万行数据卡顿问题
setDT(gcs_with_hour)
gcs_hour_min = gcs_with_hour[,
                             .(gcs_min = min(gcs, na.rm = TRUE)), # 同小时取min
                             by = .(subject_id, hadm_id, stay_id, hour_offset) # 按患者+小时分组
] %>%
  as_tibble() %>%
  # 核心排序：同一患者按小时从小到大排列（时间轴从过去到现在）
  arrange(subject_id, hour_offset)

# --------------------------
# 5. 完整保留原有数据，生成最终轨迹格式表
# --------------------------
trajectory_final_df = gcs_hour_min %>%
  left_join(
    df_teacher_new,
    by = c("subject_id", "hadm_id", "stay_id") # 匹配患者ID
  ) %>%
  # 最终排序：确保同一患者的所有数据按时间轴连续排列
  arrange(subject_id, hour_offset)

# --------------------------
# 筛选保留最小变量集
trajectory_slim = trajectory_final_df %>%
  select(subject_id,hadm_id,stay_id,
         hour_offset,gcs_min, # 轨迹核心：时间+动态GCS
         age,gender,sofa_score,sepsis3, # 关键基线协变量
         hospital_death_flag,ninety_day_survival) # 结局变量

# 导出精简版轨迹数据
write.csv(trajectory_slim,"~/Desktop/df_teacher_new2.4_trajectory.csv",row.names=F,na="")
